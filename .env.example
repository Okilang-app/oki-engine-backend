POSTGRES_PASSWORD=oki
KEYCLOAK_ADMIN_PASSWORD=oki-local-secret
KEYCLOAK_SMTP_HOST=localhost
KEYCLOAK_SMTP_PORT=1025

OKI_ENVIRONMENT=local
OKI_LOG_LEVEL=INFO
OKI_DATABASE_URL=postgresql+asyncpg://oki:oki@localhost:5432/oki
OKI_VALKEY_URL=valkey://127.0.0.1:6379/0
OKI_S3_ENDPOINT_URL=http://127.0.0.1:8333
OKI_S3_ACCESS_KEY=
OKI_S3_SECRET_KEY=
OKI_S3_BUCKET=oki-local
OKI_SENTRY_DSN=
OKI_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/oki
OKI_KEYCLOAK_AUDIENCE=oki-api
OKI_KEYCLOAK_AUTHORIZED_PARTY=oki-web
OKI_KEYCLOAK_JWKS_URI=http://127.0.0.1:8080/realms/oki/protocol/openid-connect/certs
OKI_KEYCLOAK_JWKS_CACHE_SECONDS=300
OKI_KEYCLOAK_JWKS_TIMEOUT_SECONDS=5
