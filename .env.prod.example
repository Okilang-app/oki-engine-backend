# Copy this to .env.prod and fill in all values before starting the stack.
# Never commit .env.prod — it contains secrets.

# ── Domains ──────────────────────────────────────────────────────────────────
API_DOMAIN=oki-api.ugcflow.online
AUTH_DOMAIN=oki-auth.ugcflow.online

# ── Database (Postgres in container — data stored in postgres_data volume) ──
POSTGRES_PASSWORD=change_me_strong_password

# ── Valkey / Redis ────────────────────────────────────────────────────────────
VALKEY_PASSWORD=change_me_valkey_password
# The app reads VALKEY_URL — append the password here:
OKI_VALKEY_URL=valkey://:change_me_valkey_password@valkey:6379/0

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
OKI_S3_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxxxxx
OKI_S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OKI_S3_BUCKET=oki-production

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password
OKI_KEYCLOAK_AUDIENCE=oki-api
OKI_KEYCLOAK_AUTHORIZED_PARTY=oki-web

# ── Security ──────────────────────────────────────────────────────────────────
OKI_REVIEW_LINK_SECRET=change_me_32_char_random_string_here

# ── OpenAI / Azure OpenAI ────────────────────────────────────────────────────
OKI_OPENAI_API_KEY=sk-...
# Uncomment and fill if using Azure:
# OKI_AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# OKI_AZURE_OPENAI_API_KEY=xxxxxxxx
# OKI_AZURE_WHISPER_DEPLOYMENT=whisper
# OKI_AZURE_GPT_DEPLOYMENT=gpt-4o

# ── ElevenLabs ────────────────────────────────────────────────────────────────
OKI_ELEVENLABS_API_KEY=sk_...

# ── YouTube OAuth ────────────────────────────────────────────────────────────
OKI_YOUTUBE_CLIENT_ID=
OKI_YOUTUBE_CLIENT_SECRET=
OKI_YOUTUBE_OAUTH_CALLBACK_URL=https://oki-engine.vercel.app/api/youtube/callback

# ── Token Encryption ────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OKI_TOKEN_ENCRYPTION_KEY=

# ── Sentry (optional) ────────────────────────────────────────────────────────
OKI_SENTRY_DSN=

# ── ECR (set by deploy workflow, but useful for manual pulls) ─────────────────
# ECR_IMAGE_API=123456789.dkr.ecr.eu-central-1.amazonaws.com/oki-engine
# ECR_IMAGE_WORKER=123456789.dkr.ecr.eu-central-1.amazonaws.com/oki-engine
# IMAGE_TAG=latest
