        }
      ],
      "requiredActions": [],
      "realmRoles": ["default-roles-oki"]
    },
    {
      "id": "admin-user-001",
      "username": "admin@oki.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Test",
      "email": "admin@oki.test",
      "credentials": [
        {
          "type": "password",
          "value": "OkiTest123!@"
        }
      ],
      "requiredActions": [],
      "realmRoles": ["default-roles-oki"]
    }
  ]
}
